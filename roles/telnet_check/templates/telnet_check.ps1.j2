# templates/test_connectivity.ps1.j2
# Template PowerShell para Test-NetConnection compatible con PowerShell 5.1+

$results = @()
$ErrorActionPreference = "Stop"

{% for host in telnet_check_target_hosts %}
{% for port in telnet_check_ports %}
try {
    Write-Verbose "Test de conexion a {{ host }}:{{ port }}"
    $test = Test-NetConnection -ComputerName "{{ host }}" -Port {{ port }} -InformationLevel Detailed -WarningAction SilentlyContinue
    
    if ($test.TcpTestSucceeded) {
        $status = "SUCCESS"
        $results += "{{ host }}:{{ port }} = SUCCESS"
    } else {
        $results += "{{ host }}:{{ port }} = FAILED"
    }
    
    Start-Sleep -Milliseconds 100
} catch {
    $errorMsg = $_.Exception.Message -replace '"', "'"
    $results += "{{ host }}:{{ port }} = ERROR: $errorMsg"
}
{% endfor %}
{% endfor %}

# Mostrar todos los resultados
$results | ForEach-Object { Write-Host $_ }

# Resumen:
$successCount = ($results | Where-Object { $_ -like "*SUCCESS*" }).Count
$totalTests = {{ telnet_check_target_hosts | length * telnet_check_ports | length }}
$successRate = if ($totalTests -gt 0) { [math]::Round(($successCount / $totalTests) * 100, 2) } else { 0 }

Write-Host ""
Write-Host "RESUMEN: $successCount/$totalTests exitosos ($successRate%)"
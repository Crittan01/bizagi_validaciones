#!/bin/bash
# Template Bash para telnet desde Linux

declare -a results=()
total_tests=0
success_count=0

{% for host in telnet_check_target_hosts %}
{% for port in telnet_check_ports %}
total_tests=$((total_tests + 1))

# Timeout de 5 segundos para telnet
if timeout 5 bash -c "echo >/dev/tcp/{{ host }}/{{ port }}" 2>/dev/null; then
    results+=("{{ host }}:{{ port }} = SUCCESS")
    success_count=$((success_count + 1))
else
    results+=("{{ host }}:{{ port }} = FAILED")
fi

sleep 0.1
{% endfor %}
{% endfor %}

# Mostrar resultados
for result in "${results[@]}"; do
    echo "$result"
done

# Resumen
success_rate=0
if [ $total_tests -gt 0 ]; then
    success_rate=$(echo "scale=2; ($success_count / $total_tests) * 100" | bc -l 2>/dev/null || echo "0")
fi

echo ""
echo "RESUMEN: $success_count/$total_tests exitosos (${success_rate}%)"